          "year"
        ],
        "uaa_period": null,
        "labour_period": null,
        "payment_periods": [
          "2025",
          "2026"
        ]
      },
      "assertion": "Static values remain undated reference snapshots; no operation dates or annual herd/labour observations are invented."
    },
