  "scenarios": [
    {
      "id": "null_zero_empty_string",
      "origin": "Unmodified PL source subset",
      "country": "PL",
      "source_row": 1411,
      "expected": {
        "yield_wheat_t_ha": {
          "raw": "\\N",
          "value_json": "null"
        },
        "total_livestock_units": {
          "raw": "0.0",
          "value_json": "0.0"
        },
        "main_livestock_category": {
          "raw": "",
          "value_json": "\"\""
        }
      },
      "assertion": "Never collapse absent, zero and empty string into one value."
    },
    {
      "id": "separate_annual_totals",
      "origin": "Unmodified PL source subset",
      "country": "PL",
      "source_row": 1411,
      "expected": {
        "subsidies_excl_investment_eur": "723.16",
        "payment_total_eur": "723.1600000000001"
      },
      "assertion": "Keep both named source measures and their precision. Neither add the totals nor silently overwrite either with a rounded reconciliation."
    },
    {
      "id": "high_density_diagnostic",
      "origin": "Unmodified IT source subset",
      "country": "IT",
      "source_row": 91,
      "expected": {
        "stocking_density_lu_ha": "29.289",
        "review_required": true
      },
      "assertion": "Organizer density flags are diagnostics, not automatic invalidity thresholds."
    },
    {
      "id": "static_repeated_in_years",
      "origin": "New scenario derived from organizer static-source metadata",
      "arguments": [
        "--years",
        "2025",
        "2026",
